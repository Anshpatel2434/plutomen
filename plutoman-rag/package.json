{
  "name": "plutoman-rag",
  "version": "0.1.0",
  "private": true,
  "description": "Phase-1 foundation for a multi-tenant hybrid RAG retrieval service (extension for an existing MEAN app).",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "worker": "ts-node-dev --respawn --transpile-only src/ingestion/ingestWorker.ts",
    "migrate": "ts-node scripts/migrate.ts",
    "ingest:demo": "ts-node scripts/ingest-demo.ts",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/ingestion/ingestWorker.js"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bullmq": "^5.28.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pdf-parse": "2.4.5",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
