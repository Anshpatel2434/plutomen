# ---------------------------------------------------------------------------
# plutoman-rag environment configuration (copy to .env and fill in)
# ---------------------------------------------------------------------------

# Postgres connection string used by the APPLICATION.
# IMPORTANT: this MUST be a NON-owner, non-superuser role so Row-Level Security
# is actually enforced (owners/superusers bypass RLS unless FORCE RLS is set,
# which we do set — but keeping a least-privilege app role is still required).
# Format: postgres://<user>:<password>@<host>:<port>/<database>
#
# PHASE-2: the app connects THROUGH PgBouncer (host port 6432), not directly to
# Postgres. PgBouncer runs in `transaction` pooling mode, which is safe here
# because withTenant() confines the tenant GUC to a single BEGIN/COMMIT (see
# docker-compose.yml + src/db.ts). Postgres itself is still on host port 5544.
DATABASE_URL=postgres://plutoman_app:app_password@localhost:6432/plutoman

# Owner/superuser connection used ONLY by `npm run migrate` (DDL: extensions,
# roles, tables, policies). The app role above intentionally cannot do DDL.
#
# PHASE-2: migrations MUST bypass PgBouncer and connect DIRECTLY to Postgres
# (host port 5544). DDL, advisory locks and other session-level features are
# incompatible with transaction pooling, so this URL points at 5544, not 6432.
MIGRATION_DATABASE_URL=postgres://plutoman_owner:owner_password@localhost:5544/plutoman

# Separate app-role credentials (used by migrate script / compose bootstrap).
# The migration is run by the DB owner; the app connects as PG_APP_USER.
PG_APP_USER=plutoman_app
PG_APP_PASSWORD=app_password

# Redis (BullMQ queue + worker)
REDIS_URL=redis://localhost:6379

# Ollama self-hosted inference (embeddings + generation)
OLLAMA_URL=http://localhost:11434

# Embedding model. nomic-embed-text is 768-dim and expects task prefixes.
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
# Stamped onto every chunk row so re-embeds / model swaps are traceable.
EMBED_VERSION=v1

# Generation model. Configurable to llama3.3 (both are open-source, non-Chinese).
GEN_MODEL=mistral

# Auth. Phase-1 uses HS256 shared secret. Prod path is JWKS/RS256 — see src/auth.ts.
# JWKS_URI=https://your-idp/.well-known/jwks.json   # (prod alternative)
JWT_SECRET=change-me-in-production

# --- Phase-3: JWT hardening (both OPTIONAL) ---------------------------------
# When set, jwt.verify enforces the token's `iss` / `aud` claims. Leave unset to
# skip that check (HS256 signature + expiry + required tenant_id are always
# enforced regardless).
# JWT_ISSUER=https://your-idp/
# JWT_AUDIENCE=plutoman-rag

# HTTP server port
PORT=3000

# --- Conversation memory (multi-turn /chat) ---------------------------------
# How many recent conversation turns to load as history on each /chat turn.
# Used for history-aware query rewriting AND conversational coherence in
# generation. History is for coherence only — answers stay grounded in the
# retrieved context, never in history.
CHAT_HISTORY_TURNS=6

# --- Keyword search (golden-eval change 8) ----------------------------------
# Share (0..1) of a question's rarity-weighted words a chunk must contain to
# count as a keyword match (minimum-should-match). 0.4 was best on the golden
# set (by one question over 0.5) — re-tune on a larger labelled set.
KW_MIN_MATCH_SHARE=0.4

# --- Phase-2: Redis query cache ---------------------------------------------
# TTL (seconds) for cached /search responses. Ingest also proactively
# invalidates a tenant's cache, so this is a staleness ceiling, not the only
# freshness mechanism.
CACHE_TTL_SECONDS=300
# Master switch. Set false (or 0) to bypass the cache entirely.
CACHE_ENABLED=true

# --- Phase-2 (cont.): per-tenant rate limiting ------------------------------
# Max /search + /ingest requests per tenant per fixed 60s window. Requests
# beyond this in the same window get HTTP 429 + Retry-After.
RATE_LIMIT_PER_MIN=120
# Master switch. Set false (or 0) to disable rate limiting entirely.
RATE_LIMIT_ENABLED=true

# --- Phase-2 (cont.): read/write split (read replica) -----------------------
# Optional read-replica connection string. Reads (hybrid retrieval) route here;
# writes (ingest, audit) always go to DATABASE_URL (the primary). When UNSET,
# reads fall back to the primary, so the app runs fine with no replica. Like
# DATABASE_URL, this may point at its own PgBouncer (transaction mode). The
# docker-compose replica publishes Postgres on host port 5545.
# READ_DATABASE_URL=postgres://plutoman_app:app_password@localhost:5545/plutoman

# --- Dev UI support (CORS + dev-only token endpoint) ------------------------
# Comma-separated list of browser origins allowed to call this API (CORS).
# Default is the local Angular dev UI. Parsed into an array in src/server.ts.
CORS_ORIGINS=http://localhost:4200
# Master switch for the dev-only POST /dev/token endpoint (mints an HS256 JWT so
# a browser dev UI can get a token without ever seeing JWT_SECRET). When false
# (default) that route returns 404. Enable ONLY for local demos — must stay
# disabled in production, where the real app supplies JWTs.
DEV_MODE=false
